# Downloads, model snapshots, and reusable feature caches.
/Data/
/Task_3/input_data/

# Keep compact evidence and report figures, not recovery checkpoints or raw exports.
/Task_1/results/*
!/Task_1/results/annotations/
!/Task_1/results/figures/
!/Task_1/results/histories/
!/Task_1/results/metrics/
!/Task_1/results/predictions/
/Task_1/results/predictions/*
!/Task_1/results/predictions/*_qualitative.jsonl

/Task_2/results/*
!/Task_2/results/examples/
!/Task_2/results/figures/
!/Task_2/results/histories/
!/Task_2/results/metrics/
!/Task_2/results/predictions/
!/Task_2/results/splits/

/Task_3/results/*
!/Task_3/results/figures/
!/Task_3/results/metrics/
!/Task_3/results/splits/
!/Task_3/results/tables/
!/Task_3/results/predictions/
/Task_3/results/predictions/*
!/Task_3/results/predictions/*_adaptive_states.parquet
!/Task_3/results/progress/
/Task_3/results/progress/*
!/Task_3/results/progress/live_questions.json

# Locally supplied Times New Roman font; keep it outside the public repository.
/Task_1/assets/*.ttf
/Task_2/assets/*.ttf
/Task_3/assets/*.ttf

# Local environments, caches, archives, and report documents.
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.venv/
.DS_Store
*.log
*.zip
*.pt
*.pth
*.safetensors
*.pdf
*.tex
*.bib
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.synctex.gz
*.toc
*.doc
*.docx
